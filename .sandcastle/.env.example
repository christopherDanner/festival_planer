# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: a second subscription's token, from `claude setup-token` on that
# account. When the account above runs out of window, the run switches to this
# one instead of sleeping until the reset. Leave the line in place even when
# empty: sandcastle only passes keys that are named here into the sandbox.
CLAUDE_CODE_OAUTH_TOKEN_BACKUP=

# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# GitHub personal access token — the agents use it to read/manage issues,
# push branches, and open PRs against main.
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions:
#   Issues (Read and write), Pull requests (Read and write),
#   Contents (Read and write), Metadata (Read)
GH_TOKEN=
